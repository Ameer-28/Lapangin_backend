generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  user
  admin
}

enum UserStatus {
  active
  suspended
}

enum VenueType {
  Indoor
  Outdoor
}

enum BookingStatus {
  upcoming
  completed
  cancelled
}

enum SettingCategory {
  general
  payment
  notification
  security
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  fullName            String    @map("full_name") @db.VarChar(100)
  email               String    @unique @db.VarChar(255)
  phone               String?   @db.VarChar(20)
  city                String?   @db.VarChar(100)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  avatarUrl           String?   @map("avatar_url") @db.VarChar(500)
  role                UserRole  @default(user)
  status              UserStatus @default(active)
  emailNotifications  Boolean   @default(true) @map("email_notifications")
  bookingAlerts       Boolean   @default(true) @map("booking_alerts")
  promoNotifications  Boolean   @default(true) @map("promo_notifications")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  bookings            Booking[]
  reviews             Review[]
  favorites           Favorite[]
  settingsUpdated     Setting[] @relation("SettingUpdater")

  @@map("users")
}

model Venue {
  id              String    @id @default(uuid())
  name            String    @db.VarChar(200)
  location        String    @db.VarChar(500)
  city            String    @db.VarChar(100)
  description     String?   @db.Text
  type            VenueType
  pricePerHour    Int       @map("price_per_hour")
  imageUrl        String?   @map("image_url") @db.VarChar(500)
  gallery         String[]  @default([])
  rating          Float     @default(0) @db.DoublePrecision
  reviewCount     Int       @default(0) @map("review_count")
  owner           String?   @db.VarChar(200)
  facilities      String[]  @default([])
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  timeSlots       TimeSlot[]
  bookings        Booking[]
  reviews         Review[]
  favorites       Favorite[]

  @@map("venues")
}

model TimeSlot {
  id          String   @id @default(uuid())
  venueId     String   @map("venue_id")
  date        DateTime @db.Date
  startTime   String   @map("start_time") @db.VarChar(5) // e.g. "07:00"
  isBooked    Boolean  @default(false) @map("is_booked")
  bookingId   String?  @map("booking_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([venueId, date, startTime])
  @@map("time_slots")
}

model Booking {
  id              String        @id @default(uuid())
  bookingCode     String        @unique @map("booking_code") @db.VarChar(20)
  userId          String        @map("user_id")
  venueId         String        @map("venue_id")
  date            DateTime      @db.Date
  startTime       String        @map("start_time") @db.VarChar(5)
  durationHours   Int           @map("duration_hours")
  subtotal        Int
  discount        Float         @default(0) @db.DoublePrecision
  serviceFee      Int           @default(5000) @map("service_fee")
  total           Int
  promoCode       String?       @map("promo_code") @db.VarChar(50)
  status          BookingStatus @default(upcoming)
  paymentMethod   String?       @map("payment_method") @db.VarChar(50)
  paymentDetail   String?       @map("payment_detail") @db.VarChar(100)
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue           Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  timeSlots       TimeSlot[]
  review          Review?

  @@map("bookings")
}

model Review {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  venueId     String   @map("venue_id")
  bookingId   String   @unique @map("booking_id")
  rating      Int      @db.SmallInt // 1-5
  comment     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  venueId   String   @map("venue_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
  @@map("favorites")
}

model PromoCode {
  id            String   @id @default(uuid())
  code          String   @unique @db.VarChar(50)
  discountPct   Float    @map("discount_pct") @db.DoublePrecision
  isActive      Boolean  @default(true) @map("is_active")
  validFrom     DateTime @map("valid_from")
  validUntil    DateTime @map("valid_until")
  maxUses       Int      @map("max_uses")
  usedCount     Int      @default(0) @map("used_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("promo_codes")
}

model Setting {
  id          String          @id @default(uuid())
  key         String          @unique @db.VarChar(100)
  value       String          @db.Text
  category    SettingCategory
  updatedAt   DateTime        @updatedAt @map("updated_at")
  updatedById String?         @map("updated_by_id")

  updatedBy   User?           @relation("SettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("settings")
}
